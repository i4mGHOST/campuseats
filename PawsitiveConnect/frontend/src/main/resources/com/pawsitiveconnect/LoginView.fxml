<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.text.Font?>

<StackPane prefHeight="700.0" prefWidth="1080.0" styleClass="paw-bg" stylesheets="@global-theme.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.pawsitiveconnect.LoginController">
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>

    <!-- Main Floating Split Card -->
    <HBox maxHeight="640.0" maxWidth="1020.0" styleClass="main-card">

        <!-- ================= LEFT HERO COLUMN ================= -->
        <VBox prefWidth="480.0" spacing="20.0" styleClass="hero-pane">
            <padding>
                <Insets bottom="36.0" left="36.0" right="36.0" top="36.0" />
            </padding>

            <!-- Brand Badge -->
            <Label styleClass="glass-badge" text="🐾  Rescue • Foster • Rehome">
                <font><Font name="System Bold" size="11.0" /></font>
            </Label>

            <!-- Headline -->
            <Label text="Every paw deserves&#10;a loving family." wrapText="true">
                <font><Font name="System Bold" size="28.0" /></font>
            </Label>

            <Label styleClass="hero-muted" text="Join our rescue mission and connect shelter animals to loving homes across our verified nationwide foster network." wrapText="true">
                <font><Font size="13.0" /></font>
            </Label>

            <!-- Impact Metric Box -->
            <VBox spacing="14.0" styleClass="metric-card">
                <padding>
                    <Insets bottom="16.0" left="18.0" right="18.0" top="16.0" />
                </padding>

                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <Label style="-fx-font-size: 24px;" text="🏆" />
                    <VBox>
                        <Label styleClass="hero-muted" text="COMMUNITY IMPACT">
                            <font><Font name="System Bold" size="10.0" /></font>
                        </Label>
                        <Label text="4,820+ Pets Adopted">
                            <font><Font name="System Bold" size="17.0" /></font>
                        </Label>
                    </VBox>
                </HBox>

                <Separator opacity="0.15" />

                <!-- 3 Stats -->
                <HBox alignment="CENTER" spacing="16.0">
                    <VBox alignment="CENTER">
                        <Label text="320+"><font><Font name="System Bold" size="15.0" /></font></Label>
                        <Label styleClass="hero-muted" text="Active Fosters"><font><Font size="10.5" /></font></Label>
                    </VBox>
                    <Separator opacity="0.15" orientation="VERTICAL" prefHeight="26.0" />
                    <VBox alignment="CENTER">
                        <Label text="99.4%"><font><Font name="System Bold" size="15.0" /></font></Label>
                        <Label styleClass="hero-muted" text="Rehome Rate"><font><Font size="10.5" /></font></Label>
                    </VBox>
                    <Separator opacity="0.15" orientation="VERTICAL" prefHeight="26.0" />
                    <VBox alignment="CENTER">
                        <Label text="15 min"><font><Font name="System Bold" size="15.0" /></font></Label>
                        <Label styleClass="hero-muted" text="Avg Match Time"><font><Font size="10.5" /></font></Label>
                    </VBox>
                </HBox>
            </VBox>

            <Region VBox.vgrow="ALWAYS" />

            <!-- Testimonial -->
            <HBox alignment="CENTER_LEFT" spacing="12.0">
                <StackPane maxHeight="36.0" maxWidth="36.0" minHeight="36.0" minWidth="36.0" style="-fx-background-color: rgba(224,90,71,0.35); -fx-background-radius: 999px;">
                    <Label text="🐾" />
                </StackPane>
                <Label styleClass="hero-muted" text="&quot;Finding Milo was seamless. Reunited and rehomed in less than 48 hours thanks to the shelter team.&quot;" wrapText="true">
                    <font><Font size="11.5" /></font>
                </Label>
            </HBox>
        </VBox>

        <!-- ================= RIGHT FORM COLUMN ================= -->
        <VBox alignment="CENTER_LEFT" prefWidth="540.0" spacing="14.0">
            <padding>
                <Insets bottom="40.0" left="48.0" right="48.0" top="40.0" />
            </padding>

            <VBox spacing="4.0">
                <Label text="Welcome Back">
                    <font><Font name="System Bold" size="26.0" /></font>
                </Label>
                <Label style="-fx-text-fill: #6e7968;" text="Sign in to continue to Pawsitive Connect">
                    <font><Font size="13.0" /></font>
                </Label>
            </VBox>

            <Region prefHeight="8.0" />

            <!-- Email Input -->
            <VBox spacing="5.0">
                <Label style="-fx-font-weight: bold; -fx-font-size: 11px; -fx-text-fill: #4A5243;" text="EMAIL ADDRESS" />
                <TextField fx:id="emailField" prefHeight="42.0" promptText="volunteer@pawsitive.com" styleClass="form-input" />
            </VBox>

            <!-- Password Input -->
            <VBox spacing="5.0">
                <HBox alignment="CENTER_LEFT">
                    <Label style="-fx-font-weight: bold; -fx-font-size: 11px; -fx-text-fill: #4A5243;" text="PASSWORD" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button onAction="#handleForgotPassword" styleClass="link-button" text="Forgot password?">
                        <font><Font size="11.5" /></font>
                    </Button>
                </HBox>

                <StackPane alignment="CENTER_RIGHT">
                    <PasswordField fx:id="passwordField" prefHeight="42.0" promptText="Enter your password" styleClass="form-input" />
                    <TextField fx:id="passwordTextField" managed="false" prefHeight="42.0" promptText="Enter your password" styleClass="form-input" visible="false" />
                    <Button fx:id="togglePasswordBtn" onAction="#handleTogglePassword" styleClass="eye-toggle-btn" text="👁 Show" />
                </StackPane>
            </VBox>

            <!-- Remember Me -->
            <CheckBox fx:id="rememberMeCheckbox" style="-fx-text-fill: #4A5243;" text="Keep me signed in on this device" />

            <!-- Status Label -->
            <Label fx:id="statusLabel" wrapText="true">
                <font><Font size="12.0" /></font>
            </Label>

            <!-- Submit Button -->
            <Button maxWidth="Infinity" onAction="#handleLogin" prefHeight="44.0" styleClass="primary-button" text="Log In  →" />

            <!-- Switch to Registration -->
            <HBox alignment="CENTER" spacing="6.0">
                <padding>
                    <Insets top="8.0" />
                </padding>
                <Label style="-fx-text-fill: #5F6758;" text="Don't have an account?">
                    <font><Font size="13.0" /></font>
                </Label>
                <Button onAction="#handleGoToRegister" styleClass="link-button" text="Sign Up">
                    <font><Font size="13.0" /></font>
                </Button>
            </HBox>
        </VBox>
    </HBox>
</StackPane>