<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox prefWidth="440.0" spacing="16.0" styleClass="payment-modal-card" stylesheets="@global-theme.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.pawsitiveconnect.ProcessPaymentController">
    <padding>
        <Insets bottom="24.0" left="26.0" right="26.0" top="24.0" />
    </padding>

    <!-- Modal Header -->
    <VBox spacing="4.0">
        <HBox alignment="CENTER_LEFT" spacing="6.0">
            <Label styleClass="pill-green" text="💳 Payment Settlement" />
            <Label styleClass="text-card-muted" text="• Secure Gateway" />
        </HBox>
        <Label styleClass="text-main-title" style="-fx-font-size: 22px;" text="Process Adoption Fee" />
        <Label fx:id="applicationDetailsLabel" styleClass="text-card-muted" text="App #APP-0000 | Applicant" />
    </VBox>

    <!-- Summary Box -->
    <VBox spacing="4.0" style="-fx-background-color: #eef6e4; -fx-background-radius: 14px; -fx-padding: 12px 16px;">
        <Label styleClass="text-card-muted" text="TRANSACTION SUMMARY" />
        <HBox alignment="CENTER_LEFT">
            <Label styleClass="text-item-title" text="Adoption &amp; Medical Transfer Fee" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="summaryAmountLabel" style="-fx-font-weight: 800; -fx-font-size: 18px; -fx-text-fill: #2c694e;" text="\$150.00" />
        </HBox>
    </VBox>

    <!-- Input Form -->
    <VBox spacing="12.0">
        <!-- Payer Name -->
        <VBox spacing="4.0">
            <Label style="-fx-font-weight: bold; -fx-font-size: 11px; -fx-text-fill: #4A5243;" text="PAYER FULL NAME *" />
            <TextField fx:id="payerNameField" prefHeight="40.0" promptText="e.g. Sarah Williams" styleClass="form-input" />
        </VBox>

        <!-- Amount & Method Row -->
        <HBox spacing="10.0">
            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                <Label style="-fx-font-weight: bold; -fx-font-size: 11px; -fx-text-fill: #4A5243;" text="AMOUNT ($) *" />
                <TextField fx:id="amountField" prefHeight="40.0" promptText="150.00" styleClass="form-input" />
            </VBox>

            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                <Label style="-fx-font-weight: bold; -fx-font-size: 11px; -fx-text-fill: #4A5243;" text="PAYMENT METHOD *" />
                <ComboBox fx:id="paymentMethodCombo" maxWidth="Infinity" prefHeight="40.0" />
            </VBox>
        </HBox>
    </VBox>

    <!-- Status Message -->
    <Label fx:id="statusLabel" wrapText="true">
        <font><Font size="12.0" /></font>
    </Label>

    <!-- Dialog Actions -->
    <HBox alignment="CENTER_RIGHT" spacing="10.0">
        <Button onAction="#handleCancel" styleClass="secondary-action-button" text="Cancel" />
        <Button onAction="#handleProcessPayment" styleClass="primary-button" text="Confirm &amp; Issue Receipt" />
    </HBox>
</VBox>